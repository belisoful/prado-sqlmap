<?xml version="1.0" encoding="utf-8"?>
<sqlMapConfig>

	<!-- properties that replaces instanceof $name$ in the sqlmap files -->
	<properties>
		<property name="selectKey" value="select @@IDENTITY as value" />
		<property name="MyCategoryName" value="'Film'" />
		<property name="accountName" value="'Joe'" />
	</properties>

	<!-- type handlers -->
	<typeHandlers>
		<typeHandler class="OuiNonBool" dbType="Varchar" />
	</typeHandlers>

	<!-- sqlmap configurations -->
	<sqlMaps>
		<sqlMap resource="Account.xml"/>
		<sqlMap resource="DynamicAccount.xml"/>
		<sqlMap resource="Order.xml"/>
		<sqlMap resource="Category.xml"/>
		<sqlMap resource="Complex.xml"/>
		<sqlMap resource="LineItem.xml"/>
		<sqlMap resource="Enumeration.xml"/>
		<sqlMap resource="Other.xml"/>
		<sqlMap resource="ResultClass.xml"/>
		<sqlMap resource="Document.xml"/>
		<sqlMap resource="ActiveRecord.xml"/>
	</sqlMaps>

</sqlMapConfig>